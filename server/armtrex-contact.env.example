# Copy to /etc/armtrex-contact.env on the server (chmod 600) and fill in.
# Proton Mail Business -> Settings -> IMAP/SMTP -> generate an SMTP token.
# SMTP_USER is your full Proton address; SMTP_PASS is the generated token
# (NOT your normal login password). MAIL_FROM must be a Proton address you own.

SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=info@armtrex.co.uk
SMTP_PASS=replace-with-proton-smtp-token
MAIL_TO=info@armtrex.co.uk
MAIL_FROM=info@armtrex.co.uk
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
# Origins allowed to POST to /api/contact (comma-separated). Leave blank to
# skip the check; set it once the site is live behind its real domain(s).
ALLOWED_ORIGINS=https://armtrex.co.uk,https://www.armtrex.co.uk

# --- KYC relay (Armtrex product-access requests, forwarded by the Cloudflare
#     Worker's KYC_RELAY_URL option — see worker/index.js) -----------------
KYC_MAIL_TO=info@armtrex.co.uk
# Shared secret the Worker must send in the X-Relay-Secret header. Generate
# with e.g. `openssl rand -hex 32`. Must match KYC_RELAY_SECRET set via
# `wrangler secret put KYC_RELAY_SECRET` on the Worker side.
KYC_RELAY_SECRET=replace-with-a-long-random-secret
