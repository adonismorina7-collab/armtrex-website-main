[Unit]
Description=Armtrex contact-form mail relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/armtrex-contact.env
ExecStart=/usr/bin/python3 /opt/armtrex-contact/contact_service.py
Restart=on-failure
RestartSec=3
# Hardening: the service needs nothing but the network + its own code.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
